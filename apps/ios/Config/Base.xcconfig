// Shared build settings for the Remindly app target.
// Supabase keys come from Secrets.xcconfig (gitignored). Create it with
// `apps/ios/scripts/sync-secrets.sh`, which copies them from apps/web/.env.local.

SUPABASE_HOST =
SUPABASE_ANON_KEY =

// Where the web app is hosted, e.g. remindly.example.com (no https://).
// Turns the "do this on the web" notes into links. Optional.
REMINDLY_WEB_HOST =

#include? "Secrets.xcconfig"
