# Leave both blank to run on sample data (demo mode).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sign-in buttons to show, comma-separated: google, apple, azure, github.
# Only list providers you've enabled in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Force sample data even when Supabase keys are set.
NEXT_PUBLIC_DEMO_MODE=false
